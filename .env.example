# Database - SQLite for demo, Postgres for production
DATABASE_URL="file:./dev.db"
# For Postgres use: postgresql://user:password@localhost:5432/voxentra

# Auth
JWT_SECRET="voxentra-super-secret-jwt-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Demo Mode - true = uses mock data, no real social APIs needed
DEMO_MODE="true"

# Optional Real API Keys (leave empty for Demo Mode)
# Twitter/X
TWITTER_BEARER_TOKEN=""
# Reddit
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# NewsAPI for cross-reference
NEWS_API_KEY=""

# NTRO Config
ENABLE_THREAT_INTEL="true"
LOG_LEVEL="info"
